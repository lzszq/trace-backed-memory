{
  "name": "@trace-backed-memory/agent-http",
  "version": "0.2.0",
  "description": "Typed Node.js clients for the local compatible and durable Trace-backed Memory HTTP profiles",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && node scripts/check-contract.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "prepack": "npm run build",
    "pack:check": "node scripts/check-package.mjs"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "typescript": "5.9.3"
  }
}
