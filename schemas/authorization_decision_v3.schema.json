{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lzszq/trace-backed-memory/schemas/authorization_decision_v3.schema.json",
  "title": "Trace-backed Memory authorization decision version 3 contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "authorization_event_id",
    "request_id",
    "request_sha256",
    "policy_sha256",
    "principal_id",
    "agent_client_id",
    "tenant_id",
    "repository_id",
    "permission",
    "allowed",
    "reason",
    "matched_binding_ids",
    "decided_at"
  ],
  "properties": {
    "contract_version": {
      "const": "tbm.authorization-decision.v3"
    },
    "authorization_event_id": {
      "type": "string",
      "pattern": "^authz_sha256_[0-9a-f]{64}$"
    },
    "request_id": {
      "$ref": "#/$defs/identifier"
    },
    "request_sha256": {
      "$ref": "#/$defs/digest"
    },
    "policy_sha256": {
      "$ref": "#/$defs/digest"
    },
    "principal_id": {
      "$ref": "#/$defs/identifier"
    },
    "agent_client_id": {
      "$ref": "#/$defs/identifier"
    },
    "tenant_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "repository_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "permission": {
      "enum": [
        "artifact:read",
        "artifact:write",
        "gate_session:create",
        "gate_session:transition",
        "memory:activate",
        "memory:create",
        "memory:inject",
        "memory:retrieve",
        "memory:review",
        "memory:verify",
        "platform:admin",
        "platform:audit_read",
        "policy:approve_global",
        "policy:create_global",
        "tenant:audit_read"
      ]
    },
    "allowed": {
      "type": "boolean"
    },
    "reason": {
      "enum": [
        "allowed",
        "unknown_principal",
        "principal_disabled",
        "principal_tenant_mismatch",
        "unknown_agent_client",
        "agent_client_disabled",
        "agent_client_tenant_mismatch",
        "unknown_repository",
        "repository_tenant_mismatch",
        "no_matching_binding"
      ]
    },
    "matched_binding_ids": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "decided_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allowed": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "reason": {
            "const": "allowed"
          },
          "matched_binding_ids": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "reason": {
            "not": {
              "const": "allowed"
            }
          },
          "matched_binding_ids": {
            "maxItems": 0
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableIdentifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-](?:0[0-9]|1[0-4]):[0-5][0-9])$"
    }
  }
}
