{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-backed-memory.dev/schemas/event_type_registry_v1.schema.json",
  "title": "Trace-backed Memory Event Type Registry v1",
  "$comment": "Structural preflight only. Runtime code must recompute registry and payload-schema hashes, reject duplicate type/version and schema names, seal the registry, and validate every upcast step.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_version",
    "registry_sha256",
    "event_types",
    "upcasters",
    "compatibility"
  ],
  "properties": {
    "registry_version": {"const": "tbm.event-registry.v1"},
    "registry_sha256": {"$ref": "#/$defs/digest"},
    "event_types": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {"$ref": "#/$defs/eventType"}
    },
    "upcasters": {
      "type": "array",
      "maxItems": 2048,
      "items": {"$ref": "#/$defs/upcaster"}
    },
    "compatibility": {
      "type": "array",
      "maxItems": 32768,
      "items": {"$ref": "#/$defs/compatibility"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "eventTypeName": {
      "type": "string",
      "pattern": "^tbm\\.[a-z0-9][a-z0-9_]*(?:\\.[a-z0-9][a-z0-9_]*)+$"
    },
    "payloadSchemaName": {
      "type": "string",
      "pattern": "^tbm\\.[a-z0-9][a-z0-9_.-]*\\.v[1-9][0-9]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "eventType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "event_version",
        "event_kind",
        "payload_schema",
        "payload_schema_sha256",
        "schema"
      ],
      "properties": {
        "event_type": {"$ref": "#/$defs/eventTypeName"},
        "event_version": {"$ref": "#/$defs/version"},
        "event_kind": {"enum": ["domain", "observation"]},
        "payload_schema": {"$ref": "#/$defs/payloadSchemaName"},
        "payload_schema_sha256": {"$ref": "#/$defs/digest"},
        "schema": {"type": "object"}
      }
    },
    "upcaster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "from_version",
        "to_version",
        "upcaster_id",
        "producer_version"
      ],
      "properties": {
        "event_type": {"$ref": "#/$defs/eventTypeName"},
        "from_version": {"$ref": "#/$defs/version"},
        "to_version": {"$ref": "#/$defs/version"},
        "upcaster_id": {"$ref": "#/$defs/identifier"},
        "producer_version": {"$ref": "#/$defs/identifier"}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "source_version",
        "target_version",
        "compatibility"
      ],
      "properties": {
        "event_type": {"$ref": "#/$defs/eventTypeName"},
        "source_version": {"$ref": "#/$defs/version"},
        "target_version": {"$ref": "#/$defs/version"},
        "compatibility": {"enum": ["native", "upcast", "unsupported"]}
      }
    }
  }
}
