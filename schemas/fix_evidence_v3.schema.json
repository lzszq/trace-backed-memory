{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-backed-memory.local/schemas/fix_evidence_v3.schema.json",
  "title": "Trace-backed Memory Fix Evidence v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "evidence_id",
    "case_id",
    "source_trace_id",
    "source_commit_sha",
    "fix_commit_sha",
    "source_to_fix",
    "artifact_hashes",
    "submitter_id",
    "submitted_at",
    "reviewer_id",
    "reviewed_at",
    "attestation_sha256"
  ],
  "properties": {
    "contract_version": { "const": "tbm.fix-evidence.v3" },
    "evidence_id": {
      "type": "string",
      "pattern": "^fix_evidence_sha256_[0-9a-f]{64}$"
    },
    "case_id": { "$ref": "#/$defs/identifier" },
    "source_trace_id": { "$ref": "#/$defs/identifier" },
    "source_commit_sha": { "$ref": "#/$defs/metadata" },
    "fix_commit_sha": { "$ref": "#/$defs/metadata" },
    "source_to_fix": { "$ref": "#/$defs/commitRelation" },
    "artifact_hashes": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/digest" }
    },
    "submitter_id": { "$ref": "#/$defs/identifier" },
    "submitted_at": { "$ref": "#/$defs/timestamp" },
    "reviewer_id": { "$ref": "#/$defs/identifier" },
    "reviewed_at": { "$ref": "#/$defs/timestamp" },
    "attestation_sha256": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": ".*\\S.*"
    },
    "metadata": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-](?:0[0-9]|1[0-4]):[0-5][0-9])$"
    },
    "commitRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_commit_sha",
        "to_commit_sha",
        "relation",
        "verified_by",
        "verified_at"
      ],
      "properties": {
        "from_commit_sha": { "$ref": "#/$defs/metadata" },
        "to_commit_sha": { "$ref": "#/$defs/metadata" },
        "relation": { "const": "ancestor" },
        "verified_by": { "$ref": "#/$defs/identifier" },
        "verified_at": { "$ref": "#/$defs/timestamp" }
      }
    }
  }
}
