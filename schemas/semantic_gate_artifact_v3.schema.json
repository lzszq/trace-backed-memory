{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lzszq/trace-backed-memory/schemas/semantic_gate_artifact_v3.schema.json",
  "title": "Trace-backed Memory Semantic Gate artifact binding version 3 contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "artifact_kind",
    "artifact_role",
    "attempt_id",
    "artifact"
  ],
  "properties": {
    "contract_version": {
      "const": "tbm.semantic-gate-artifact.v3"
    },
    "artifact_kind": {
      "const": "semantic_gate"
    },
    "artifact_role": {
      "enum": [
        "prompt",
        "response"
      ]
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^semantic_attempt_sha256_[0-9a-f]{64}$"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_role": {
            "const": "prompt"
          }
        },
        "required": [
          "artifact_role"
        ]
      },
      "then": {
        "properties": {
          "artifact": {
            "properties": {
              "media_type": {
                "const": "text/plain; charset=utf-8"
              },
              "size_bytes": {
                "maximum": 128000
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_role": {
            "const": "response"
          }
        },
        "required": [
          "artifact_role"
        ]
      },
      "then": {
        "properties": {
          "artifact": {
            "properties": {
              "size_bytes": {
                "maximum": 65536
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "content_sha256",
        "size_bytes",
        "media_type",
        "classification",
        "created_at",
        "encryption_key_id",
        "redaction_policy_id"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^artifact_sha256_[0-9a-f]{64}$"
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128000
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": ".*\\S.*"
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "encryption_key_id": {
          "$ref": "#/$defs/nullableIdentifier"
        },
        "redaction_policy_id": {
          "$ref": "#/$defs/nullableIdentifier"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "classification": {
                "enum": [
                  "confidential",
                  "restricted"
                ]
              }
            },
            "required": [
              "classification"
            ]
          },
          "then": {
            "properties": {
              "encryption_key_id": {
                "$ref": "#/$defs/identifier"
              }
            }
          }
        }
      ]
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": ".*\\S.*"
    },
    "nullableIdentifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
