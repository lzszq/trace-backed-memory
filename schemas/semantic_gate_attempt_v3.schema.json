{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-backed-memory.dev/schemas/semantic_gate_attempt_v3.schema.json",
  "title": "Trace-backed Memory Semantic Gate Attempt v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "attempt_id",
    "session_id",
    "retrieval_snapshot_id",
    "system_gate_evaluation_id",
    "sequence",
    "previous_attempt_id",
    "provider_id",
    "model_id",
    "model_version",
    "endpoint_id",
    "prompt_template_id",
    "prompt_template_version",
    "prompt_artifact_sha256",
    "response_artifact_sha256",
    "generation_config_sha256",
    "provider_request_id",
    "status",
    "decision_id",
    "final_allowed_revision_ids",
    "final_blocked_revision_ids",
    "reason",
    "risk",
    "recommended_injection",
    "error_code",
    "input_tokens",
    "output_tokens",
    "latency_ms",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "contract_version": {
      "const": "tbm.semantic-gate-attempt.v3"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^semantic_attempt_sha256_[0-9a-f]{64}$"
    },
    "session_id": {
      "$ref": "#/$defs/identifier"
    },
    "retrieval_snapshot_id": {
      "type": "string",
      "pattern": "^retrieval_snapshot_sha256_[0-9a-f]{64}$"
    },
    "system_gate_evaluation_id": {
      "type": "string",
      "pattern": "^system_gate_sha256_[0-9a-f]{64}$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "previous_attempt_id": {
      "$ref": "#/$defs/nullableAttemptId"
    },
    "provider_id": {
      "$ref": "#/$defs/identifier"
    },
    "model_id": {
      "$ref": "#/$defs/identifier"
    },
    "model_version": {
      "$ref": "#/$defs/identifier"
    },
    "endpoint_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "prompt_template_id": {
      "$ref": "#/$defs/identifier"
    },
    "prompt_template_version": {
      "$ref": "#/$defs/identifier"
    },
    "prompt_artifact_sha256": {
      "$ref": "#/$defs/digest"
    },
    "response_artifact_sha256": {
      "$ref": "#/$defs/nullableDigest"
    },
    "generation_config_sha256": {
      "$ref": "#/$defs/digest"
    },
    "provider_request_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed"
      ]
    },
    "decision_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "final_allowed_revision_ids": {
      "$ref": "#/$defs/revisionIds"
    },
    "final_blocked_revision_ids": {
      "$ref": "#/$defs/revisionIds"
    },
    "reason": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": ".*\\S.*"
        },
        {
          "type": "null"
        }
      ]
    },
    "risk": {
      "oneOf": [
        {
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "recommended_injection": {
      "oneOf": [
        {
          "enum": [
            "none",
            "summary",
            "full"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "error_code": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "input_tokens": {
      "$ref": "#/$defs/nullableCount"
    },
    "output_tokens": {
      "$ref": "#/$defs/nullableCount"
    },
    "latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "started_at": {
      "$ref": "#/$defs/timestamp"
    },
    "finished_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": ".*\\S.*"
    },
    "nullableIdentifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "nullableDigest": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullableAttemptId": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^semantic_attempt_sha256_[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "revisionIds": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^memory_revision_sha256_[0-9a-f]{64}$"
      }
    },
    "nullableCount": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        {
          "type": "null"
        }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-](?:0[0-9]|1[0-4]):[0-5][0-9])$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "sequence": {
            "const": 1
          }
        },
        "required": [
          "sequence"
        ]
      },
      "then": {
        "properties": {
          "previous_attempt_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_attempt_id": {
            "type": "string",
            "pattern": "^semantic_attempt_sha256_[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "succeeded"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "endpoint_id": {
            "$ref": "#/$defs/identifier"
          },
          "provider_request_id": {
            "$ref": "#/$defs/identifier"
          },
          "response_artifact_sha256": {
            "$ref": "#/$defs/digest"
          },
          "decision_id": {
            "$ref": "#/$defs/identifier"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": ".*\\S.*"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "unknown"
            ]
          },
          "recommended_injection": {
            "enum": [
              "none",
              "summary",
              "full"
            ]
          },
          "error_code": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "response_artifact_sha256": {
            "type": "null"
          },
          "decision_id": {
            "type": "null"
          },
          "final_allowed_revision_ids": {
            "maxItems": 0
          },
          "final_blocked_revision_ids": {
            "maxItems": 0
          },
          "reason": {
            "type": "null"
          },
          "risk": {
            "type": "null"
          },
          "recommended_injection": {
            "type": "null"
          },
          "error_code": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  ]
}
