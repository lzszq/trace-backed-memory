{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "trace.schema.json",
  "title": "Trace",
  "type": "object",
  "required": ["trace_id", "run_id", "commit_sha"],
  "properties": {
    "trace_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "commit_sha": {"type": "string", "minLength": 1, "maxLength": 512},
    "repo": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "tenant": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "branch": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "dirty": {"type": "boolean", "default": false},
    "prompt_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "prompt_family": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "tool_schema_version": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "model": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "eval_suite": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "input_hash": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "output_hash": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "retrieved_context": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "tool_calls": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "tool_outputs": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": true},
      "default": []
    },
    "eval_result": {
      "type": "string",
      "enum": ["pass", "fail", "error", "unknown"],
      "default": "unknown"
    },
    "latency_ms": {"type": ["integer", "null"], "minimum": 0},
    "cost_usd": {"type": ["number", "null"]},
    "error": {"type": ["string", "null"], "minLength": 1},
    "trace_uri": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "created_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}
