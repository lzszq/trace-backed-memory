{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceBackedMemoryAgentCompleteRequest",
  "type": "object",
  "required": ["decision_id", "eval_result"],
  "properties": {
    "decision_id": {"type": "string", "pattern": "\\S", "maxLength": 128},
    "eval_result": {
      "type": "string",
      "enum": ["pass", "fail", "error"]
    },
    "memory_caused_failure": {"type": "boolean", "default": false},
    "output_hash": {
      "type": ["string", "null"],
      "pattern": "\\S",
      "maxLength": 512
    },
    "tool_outputs": {
      "anyOf": [
        {
          "type": "array",
          "maxItems": 100000,
          "items": {"type": "object"}
        },
        {"type": "null"}
      ]
    },
    "latency_ms": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        {"type": "null"}
      ]
    },
    "cost_usd": {"type": ["number", "null"]},
    "error": {
      "type": ["string", "null"],
      "pattern": "\\S",
      "maxLength": 8388608
    },
    "trace_uri": {
      "type": ["string", "null"],
      "pattern": "\\S",
      "maxLength": 512
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"memory_caused_failure": {"const": true}},
        "required": ["memory_caused_failure"]
      },
      "then": {
        "properties": {
          "eval_result": {"enum": ["fail", "error"]}
        }
      }
    }
  ],
  "additionalProperties": false
}
