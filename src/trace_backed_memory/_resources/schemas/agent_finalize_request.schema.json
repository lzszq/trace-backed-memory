{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceBackedMemoryAgentFinalizeRequest",
  "type": "object",
  "required": [
    "request_id",
    "use_memory",
    "allowed_memory_ids",
    "blocked_memory_ids",
    "reason",
    "risk",
    "recommended_injection"
  ],
  "properties": {
    "request_id": {"type": "string", "pattern": "\\S", "maxLength": 128},
    "use_memory": {"type": "boolean"},
    "allowed_memory_ids": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "pattern": "\\S", "maxLength": 128},
      "uniqueItems": true
    },
    "blocked_memory_ids": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "pattern": "\\S", "maxLength": 128},
      "uniqueItems": true
    },
    "reason": {"type": "string", "pattern": "\\S", "maxLength": 2000},
    "risk": {
      "type": "string",
      "enum": ["none", "low", "medium", "high"]
    },
    "recommended_injection": {
      "type": "string",
      "enum": ["none", "short_summary", "full_case_summary", "pointer_only"]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"use_memory": {"const": true}}
      },
      "then": {
        "properties": {
          "allowed_memory_ids": {"minItems": 1},
          "recommended_injection": {"not": {"const": "none"}}
        }
      },
      "else": {
        "properties": {
          "allowed_memory_ids": {"maxItems": 0},
          "recommended_injection": {"const": "none"}
        }
      }
    }
  ],
  "additionalProperties": false
}
