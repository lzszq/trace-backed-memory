{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TraceBackedMemoryAgentPrepared",
  "type": "object",
  "required": [
    "protocol_version",
    "request_id",
    "trace_id",
    "run_id",
    "candidate_memory_ids",
    "system_allowed_memory_ids",
    "system_blocked",
    "prompt"
  ],
  "properties": {
    "protocol_version": {"const": "tbm.agent.v1"},
    "request_id": {"type": "string", "pattern": "\\S", "maxLength": 128},
    "trace_id": {"type": "string", "pattern": "\\S", "maxLength": 128},
    "run_id": {"type": "string", "pattern": "\\S", "maxLength": 128},
    "candidate_memory_ids": {
      "type": "array",
      "maxItems": 1000,
      "items": {"type": "string", "minLength": 1, "maxLength": 128},
      "uniqueItems": true
    },
    "system_allowed_memory_ids": {
      "type": "array",
      "maxItems": 50,
      "items": {"type": "string", "minLength": 1, "maxLength": 128},
      "uniqueItems": true
    },
    "system_blocked": {
      "type": "object",
      "maxProperties": 1000,
      "additionalProperties": {"type": "string", "pattern": "\\S", "maxLength": 2000}
    },
    "prompt": {"type": "string", "maxLength": 32000}
  },
  "additionalProperties": false
}
