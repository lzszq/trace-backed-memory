{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lzszq/trace-backed-memory/schemas/gate_session_v3.schema.json",
  "title": "Trace-backed Memory durable GateSession version 3 contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "session_id",
    "tenant_id",
    "repository_id",
    "principal_id",
    "agent_client_id",
    "trace_id",
    "run_id",
    "request_fingerprint",
    "idempotency_key",
    "status",
    "version",
    "created_at",
    "updated_at",
    "expires_at",
    "lease_expires_at",
    "retrieval_snapshot_id",
    "system_gate_evaluation_id",
    "semantic_gate_attempt_ids",
    "decision_id",
    "final_memory_revision_ids",
    "injection_artifact_id",
    "usage_decision_id",
    "run_outcome_id",
    "terminal_reason"
  ],
  "properties": {
    "contract_version": {
      "const": "tbm.gate-session.v3"
    },
    "session_id": {
      "$ref": "#/$defs/identifier"
    },
    "tenant_id": {
      "$ref": "#/$defs/identifier"
    },
    "repository_id": {
      "$ref": "#/$defs/identifier"
    },
    "principal_id": {
      "$ref": "#/$defs/identifier"
    },
    "agent_client_id": {
      "$ref": "#/$defs/identifier"
    },
    "trace_id": {
      "$ref": "#/$defs/identifier"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "request_fingerprint": {
      "$ref": "#/$defs/digest"
    },
    "idempotency_key": {
      "$ref": "#/$defs/metadata"
    },
    "status": {
      "enum": [
        "created",
        "prepared",
        "awaiting_decision",
        "decided",
        "finalized",
        "executing",
        "completed",
        "canceled",
        "expired",
        "abandoned"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "lease_expires_at": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieval_snapshot_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "system_gate_evaluation_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "semantic_gate_attempt_ids": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "decision_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "final_memory_revision_ids": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/identifier"
      }
    },
    "injection_artifact_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "usage_decision_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "run_outcome_id": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "terminal_reason": {
      "oneOf": [
        {
          "$ref": "#/$defs/reason"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "created"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lease_expires_at": {
            "type": "null"
          },
          "retrieval_snapshot_id": {
            "type": "null"
          },
          "system_gate_evaluation_id": {
            "type": "null"
          },
          "semantic_gate_attempt_ids": {
            "maxItems": 0
          },
          "decision_id": {
            "type": "null"
          },
          "final_memory_revision_ids": {
            "maxItems": 0
          },
          "injection_artifact_id": {
            "type": "null"
          },
          "usage_decision_id": {
            "type": "null"
          },
          "run_outcome_id": {
            "type": "null"
          },
          "terminal_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "prepared",
              "awaiting_decision"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lease_expires_at": {
            "$ref": "#/$defs/timestamp"
          },
          "retrieval_snapshot_id": {
            "$ref": "#/$defs/identifier"
          },
          "system_gate_evaluation_id": {
            "$ref": "#/$defs/identifier"
          },
          "decision_id": {
            "type": "null"
          },
          "injection_artifact_id": {
            "type": "null"
          },
          "usage_decision_id": {
            "type": "null"
          },
          "run_outcome_id": {
            "type": "null"
          },
          "terminal_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "decided"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lease_expires_at": {
            "$ref": "#/$defs/timestamp"
          },
          "retrieval_snapshot_id": {
            "$ref": "#/$defs/identifier"
          },
          "system_gate_evaluation_id": {
            "$ref": "#/$defs/identifier"
          },
          "decision_id": {
            "$ref": "#/$defs/identifier"
          },
          "injection_artifact_id": {
            "type": "null"
          },
          "usage_decision_id": {
            "type": "null"
          },
          "run_outcome_id": {
            "type": "null"
          },
          "terminal_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "finalized",
              "executing"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lease_expires_at": {
            "$ref": "#/$defs/timestamp"
          },
          "retrieval_snapshot_id": {
            "$ref": "#/$defs/identifier"
          },
          "system_gate_evaluation_id": {
            "$ref": "#/$defs/identifier"
          },
          "decision_id": {
            "$ref": "#/$defs/identifier"
          },
          "injection_artifact_id": {
            "$ref": "#/$defs/identifier"
          },
          "usage_decision_id": {
            "$ref": "#/$defs/identifier"
          },
          "run_outcome_id": {
            "type": "null"
          },
          "terminal_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lease_expires_at": {
            "type": "null"
          },
          "retrieval_snapshot_id": {
            "$ref": "#/$defs/identifier"
          },
          "system_gate_evaluation_id": {
            "$ref": "#/$defs/identifier"
          },
          "decision_id": {
            "$ref": "#/$defs/identifier"
          },
          "injection_artifact_id": {
            "$ref": "#/$defs/identifier"
          },
          "usage_decision_id": {
            "$ref": "#/$defs/identifier"
          },
          "run_outcome_id": {
            "$ref": "#/$defs/identifier"
          },
          "terminal_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "canceled"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lease_expires_at": {
            "type": "null"
          },
          "semantic_gate_attempt_ids": {
            "maxItems": 0
          },
          "decision_id": {
            "type": "null"
          },
          "final_memory_revision_ids": {
            "maxItems": 0
          },
          "injection_artifact_id": {
            "type": "null"
          },
          "usage_decision_id": {
            "type": "null"
          },
          "run_outcome_id": {
            "type": "null"
          },
          "terminal_reason": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "expired"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lease_expires_at": {
            "type": "null"
          },
          "retrieval_snapshot_id": {
            "$ref": "#/$defs/identifier"
          },
          "system_gate_evaluation_id": {
            "$ref": "#/$defs/identifier"
          },
          "semantic_gate_attempt_ids": {
            "maxItems": 0
          },
          "decision_id": {
            "type": "null"
          },
          "final_memory_revision_ids": {
            "maxItems": 0
          },
          "injection_artifact_id": {
            "type": "null"
          },
          "usage_decision_id": {
            "type": "null"
          },
          "run_outcome_id": {
            "type": "null"
          },
          "terminal_reason": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "abandoned"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "lease_expires_at": {
            "type": "null"
          },
          "retrieval_snapshot_id": {
            "$ref": "#/$defs/identifier"
          },
          "system_gate_evaluation_id": {
            "$ref": "#/$defs/identifier"
          },
          "decision_id": {
            "$ref": "#/$defs/identifier"
          },
          "injection_artifact_id": {
            "$ref": "#/$defs/identifier"
          },
          "usage_decision_id": {
            "$ref": "#/$defs/identifier"
          },
          "run_outcome_id": {
            "type": "null"
          },
          "terminal_reason": {
            "$ref": "#/$defs/reason"
          }
        }
      }
    },
    {
      "oneOf": [
        {
          "properties": {
            "retrieval_snapshot_id": {
              "type": "null"
            },
            "system_gate_evaluation_id": {
              "type": "null"
            }
          }
        },
        {
          "properties": {
            "retrieval_snapshot_id": {
              "$ref": "#/$defs/identifier"
            },
            "system_gate_evaluation_id": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      ]
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": ".*\\S.*"
    },
    "nullableIdentifier": {
      "oneOf": [
        {
          "$ref": "#/$defs/identifier"
        },
        {
          "type": "null"
        }
      ]
    },
    "metadata": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": ".*\\S.*"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    }
  }
}
