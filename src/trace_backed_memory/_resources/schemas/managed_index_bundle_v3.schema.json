{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-backed-memory.local/schemas/managed_index_bundle_v3.schema.json",
  "$comment": "This schema validates the bounded external shape. The strict runtime loader is normative for canonical Unicode tokenization, UTF-8 byte bounds, ordering, hashes, graph references, and other cross-record invariants that JSON Schema cannot express.",
  "title": "Trace-backed Memory managed index bundle v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_id",
    "candidates",
    "contract_version",
    "environment_id",
    "evidence_edges",
    "git_commits",
    "git_edges",
    "index_versions",
    "repository_id",
    "retriever_id",
    "retriever_version",
    "semantic_dimension",
    "semantic_metric",
    "semantic_provider_id",
    "semantic_provider_version",
    "source_catalog_sha256",
    "tenant_id",
    "tokenizer_id",
    "tokenizer_version"
  ],
  "properties": {
    "bundle_id": {
      "type": "string",
      "pattern": "^managed_index_bundle_sha256_[0-9a-f]{64}$"
    },
    "candidates": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "#/$defs/candidate"
      }
    },
    "contract_version": {
      "const": "tbm.managed-index-bundle.v3"
    },
    "environment_id": {
      "$ref": "#/$defs/identifier"
    },
    "evidence_edges": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/evidence_edge"
      }
    },
    "git_commits": {
      "type": "array",
      "maxItems": 20000,
      "items": {
        "$ref": "#/$defs/metadata"
      }
    },
    "git_edges": {
      "type": "array",
      "maxItems": 50000,
      "items": {
        "$ref": "#/$defs/git_edge"
      }
    },
    "index_versions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/index_version"
      }
    },
    "repository_id": {
      "$ref": "#/$defs/identifier"
    },
    "retriever_id": {
      "$ref": "#/$defs/identifier"
    },
    "retriever_version": {
      "$ref": "#/$defs/identifier"
    },
    "semantic_dimension": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4096
    },
    "semantic_metric": {
      "const": "cosine"
    },
    "semantic_provider_id": {
      "$ref": "#/$defs/identifier"
    },
    "semantic_provider_version": {
      "$ref": "#/$defs/identifier"
    },
    "source_catalog_sha256": {
      "$ref": "#/$defs/digest"
    },
    "tenant_id": {
      "$ref": "#/$defs/identifier"
    },
    "tokenizer_id": {
      "$ref": "#/$defs/identifier"
    },
    "tokenizer_version": {
      "$ref": "#/$defs/identifier"
    }
  },
  "$defs": {
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_sha256",
        "classification",
        "eval_leaking",
        "evidence_ids",
        "git_anchor_commit_sha",
        "lexical_tokens",
        "memory_id",
        "memory_kind",
        "memory_revision_id",
        "memory_type",
        "scope_attributes",
        "semantic_vector"
      ],
      "properties": {
        "candidate_sha256": {
          "$ref": "#/$defs/digest"
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "eval_leaking": {
          "type": "boolean"
        },
        "evidence_ids": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "git_anchor_commit_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/metadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "lexical_tokens": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "memory_id": {
          "$ref": "#/$defs/identifier"
        },
        "memory_kind": {
          "enum": [
            "lesson",
            "project_policy"
          ]
        },
        "memory_revision_id": {
          "type": "string",
          "pattern": "^memory_revision_sha256_[0-9a-f]{64}$"
        },
        "memory_type": {
          "enum": [
            "procedural",
            "semantic",
            "episodic",
            "policy"
          ]
        },
        "scope_attributes": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          }
        },
        "semantic_vector": {
          "oneOf": [
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "contains": {
                "not": {
                  "const": 0
                }
              },
              "items": {
                "type": "number"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "classification"
            ],
            "properties": {
              "classification": {
                "enum": [
                  "confidential",
                  "restricted"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "lexical_tokens": {
                "maxItems": 0
              },
              "semantic_vector": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "memory_kind"
            ],
            "properties": {
              "memory_kind": {
                "const": "lesson"
              }
            }
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              },
              "git_anchor_commit_sha": {
                "$ref": "#/$defs/metadata"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "memory_kind"
            ],
            "properties": {
              "memory_kind": {
                "const": "project_policy"
              }
            }
          },
          "then": {
            "properties": {
              "git_anchor_commit_sha": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "evidence_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "query_token",
        "weight"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/identifier"
        },
        "query_token": {
          "$ref": "#/$defs/token"
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "git_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "child_commit_sha",
        "parent_commit_sha"
      ],
      "properties": {
        "child_commit_sha": {
          "$ref": "#/$defs/metadata"
        },
        "parent_commit_sha": {
          "$ref": "#/$defs/metadata"
        }
      }
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "index_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sha256",
        "index_id",
        "index_kind",
        "index_version"
      ],
      "properties": {
        "content_sha256": {
          "$ref": "#/$defs/digest"
        },
        "index_id": {
          "$ref": "#/$defs/identifier"
        },
        "index_kind": {
          "enum": [
            "metadata",
            "lexical",
            "semantic",
            "evidence_graph",
            "git_graph"
          ]
        },
        "index_version": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "metadata": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*[A-Z])[^\\W_]{2,}$"
    }
  }
}
