{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_usage_log.schema.json",
  "title": "MemoryUsageLog",
  "type": "object",
  "required": [
    "decision_id",
    "run_id",
    "mode",
    "candidate_memory_ids",
    "used_memory_ids",
    "blocked_memory_ids",
    "reason",
    "risk",
    "recommended_injection",
    "trace_id",
    "context",
    "candidate_memory_statuses",
    "system_blocked_reasons"
  ],
  "properties": {
    "decision_id": {"type": "string", "pattern": "\\S", "minLength": 1, "maxLength": 128},
    "run_id": {"type": "string", "pattern": "\\S", "minLength": 1, "maxLength": 128},
    "mode": {
      "type": "string",
      "enum": ["debug", "repair", "regression", "planning", "eval", "production"]
    },
    "candidate_memory_ids": {"$ref": "#/$defs/memory_id_list"},
    "used_memory_ids": {"$ref": "#/$defs/memory_id_list"},
    "blocked_memory_ids": {"$ref": "#/$defs/memory_id_list"},
    "reason": {"type": "string", "pattern": "\\S", "maxLength": 2000},
    "risk": {
      "type": "string",
      "enum": ["none", "low", "medium", "high"]
    },
    "recommended_injection": {
      "type": "string",
      "enum": ["none", "short_summary", "full_case_summary", "pointer_only"]
    },
    "eval_result": {
      "type": ["string", "null"],
      "enum": ["pass", "fail", "error", "unknown", null],
      "default": null
    },
    "memory_caused_failure": {"type": "boolean", "default": false},
    "trace_id": {"type": "string", "pattern": "\\S", "minLength": 1, "maxLength": 128},
    "context": {
      "type": "object",
      "propertyNames": {"pattern": "\\S"},
      "additionalProperties": {"type": "string", "pattern": "\\S", "minLength": 1, "maxLength": 512},
      "default": {}
    },
    "candidate_memory_statuses": {
      "type": "object",
      "propertyNames": {"pattern": "\\S", "maxLength": 128},
      "additionalProperties": {
        "type": "string",
        "enum": ["draft", "verified", "active", "obsolete"]
      },
      "default": {}
    },
    "system_blocked_reasons": {
      "type": "object",
      "propertyNames": {"pattern": "\\S", "maxLength": 128},
      "additionalProperties": {"type": "string", "pattern": "\\S", "minLength": 1},
      "default": {}
    },
    "created_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "used_memory_ids": {"maxItems": 0}
        }
      },
      "then": {
        "properties": {
          "recommended_injection": {"const": "none"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "used_memory_ids": {"minItems": 1}
        }
      },
      "then": {
        "properties": {
          "recommended_injection": {"not": {"const": "none"}}
        }
      }
    },
    {
      "if": {
        "required": ["memory_caused_failure"],
        "properties": {
          "memory_caused_failure": {"const": true}
        }
      },
      "then": {
        "required": ["eval_result"],
        "properties": {
          "used_memory_ids": {"minItems": 1},
          "eval_result": {"enum": ["fail", "error"]}
        }
      }
    }
  ],
  "$defs": {
    "memory_id_list": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 128},
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
