{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-backed-memory.dev/schemas/outcome_attribution_v3.schema.json",
  "title": "Trace-backed Memory OutcomeAttribution v3",
  "$comment": "Structural preflight only. Runtime validation must verify sorted arrays, evaluator/verifier separation, cross-record linkage, canonical time, and the content-derived identifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "attribution_id",
    "run_outcome_id",
    "usage_decision_id",
    "memory_revision_ids",
    "claim_strength",
    "effect",
    "method",
    "evaluator_id",
    "evaluator_version",
    "verifier_id",
    "evidence_artifact_sha256s",
    "confidence",
    "reason",
    "recorded_at"
  ],
  "properties": {
    "contract_version": {
      "const": "tbm.outcome-attribution.v3"
    },
    "attribution_id": {
      "type": "string",
      "pattern": "^outcome_attribution_sha256_[0-9a-f]{64}$"
    },
    "run_outcome_id": {
      "type": "string",
      "pattern": "^run_outcome_sha256_[0-9a-f]{64}$"
    },
    "usage_decision_id": {
      "$ref": "#/$defs/identifier"
    },
    "memory_revision_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^memory_revision_sha256_[0-9a-f]{64}$"
      }
    },
    "claim_strength": {
      "enum": ["association", "causal"]
    },
    "effect": {
      "enum": ["helped", "harmed", "neutral", "unknown"]
    },
    "method": {
      "enum": [
        "runtime_observation",
        "controlled_experiment",
        "manual_review",
        "external_evaluation"
      ]
    },
    "evaluator_id": {
      "$ref": "#/$defs/identifier"
    },
    "evaluator_version": {
      "$ref": "#/$defs/identifier"
    },
    "verifier_id": {
      "oneOf": [
        {"$ref": "#/$defs/identifier"},
        {"type": "null"}
      ]
    },
    "evidence_artifact_sha256s": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/digest"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"claim_strength": {"const": "association"}},
        "required": ["claim_strength"]
      },
      "then": {
        "properties": {
          "method": {"const": "runtime_observation"},
          "verifier_id": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "method": {
            "enum": [
              "controlled_experiment",
              "manual_review",
              "external_evaluation"
            ]
          },
          "effect": {
            "enum": ["helped", "harmed", "neutral"]
          },
          "verifier_id": {
            "$ref": "#/$defs/identifier"
          }
        }
      }
    }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\u0000-\\u001f\\u007f]{1,128}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
