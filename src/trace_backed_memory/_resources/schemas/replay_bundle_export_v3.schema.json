{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/lzszq/trace-backed-memory/schemas/replay_bundle_export_v3.schema.json",
  "title": "Trace-backed Memory replay bundle export version 3 contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "export_kind",
    "export_sha256",
    "content_encoding",
    "manifest",
    "injection",
    "artifacts"
  ],
  "properties": {
    "contract_version": {
      "const": "tbm.replay-export.v3"
    },
    "export_kind": {
      "const": "decision_replay_bundle"
    },
    "export_sha256": {
      "$ref": "#/$defs/digest"
    },
    "content_encoding": {
      "const": "base64"
    },
    "manifest": {
      "$ref": "decision_replay_manifest_v3.schema.json"
    },
    "injection": {
      "oneOf": [
        {
          "$ref": "injection_artifact_v3.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/exportArtifact"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifactId": {
      "type": "string",
      "pattern": "^artifact_sha256_[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]{1,6})?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "contentArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "content_sha256",
        "size_bytes",
        "media_type",
        "classification",
        "created_at",
        "encryption_key_id",
        "redaction_policy_id"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/artifactId"
        },
        "content_sha256": {
          "$ref": "#/$defs/digest"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": ".*\\S.*"
        },
        "classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        },
        "created_at": {
          "$ref": "#/$defs/timestamp"
        },
        "encryption_key_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": ".*\\S.*"
        },
        "redaction_policy_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128,
          "pattern": ".*\\S.*"
        }
      }
    },
    "exportArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_name",
        "artifact",
        "content_base64"
      ],
      "properties": {
        "component_name": {
          "enum": [
            "retrieval_snapshot",
            "system_gate_evaluation",
            "semantic_gate_prompt",
            "semantic_gate_response",
            "ancestry_evidence",
            "policy_bundle",
            "renderer",
            "injection_artifact"
          ]
        },
        "artifact": {
          "$ref": "#/$defs/contentArtifact"
        },
        "content_base64": {
          "type": "string",
          "maxLength": 11184812,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    }
  }
}
