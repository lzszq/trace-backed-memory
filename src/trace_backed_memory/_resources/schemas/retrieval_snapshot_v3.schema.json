{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trace-backed-memory.dev/schemas/retrieval_snapshot_v3.schema.json",
  "title": "Trace-backed Memory Retrieval Snapshot v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "snapshot_id",
    "session_id",
    "request_id",
    "trace_id",
    "run_id",
    "authorization_event_id",
    "context_sha256",
    "query_sha256",
    "retrieval_mode",
    "retriever_id",
    "retriever_version",
    "index_versions",
    "hits",
    "total_candidates",
    "top_k",
    "truncated",
    "truncation_reasons",
    "created_at"
  ],
  "properties": {
    "contract_version": {
      "const": "tbm.retrieval-snapshot.v3"
    },
    "snapshot_id": {
      "type": "string",
      "pattern": "^retrieval_snapshot_sha256_[0-9a-f]{64}$"
    },
    "session_id": {
      "$ref": "#/$defs/identifier"
    },
    "request_id": {
      "$ref": "#/$defs/identifier"
    },
    "trace_id": {
      "$ref": "#/$defs/identifier"
    },
    "run_id": {
      "$ref": "#/$defs/identifier"
    },
    "authorization_event_id": {
      "type": "string",
      "pattern": "^authz_sha256_[0-9a-f]{64}$"
    },
    "context_sha256": {
      "$ref": "#/$defs/digest"
    },
    "query_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "retrieval_mode": {
      "enum": [
        "metadata",
        "lexical",
        "semantic",
        "evidence_graph",
        "hybrid"
      ]
    },
    "retriever_id": {
      "$ref": "#/$defs/identifier"
    },
    "retriever_version": {
      "$ref": "#/$defs/identifier"
    },
    "index_versions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/indexVersion"
      }
    },
    "hits": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/retrievalHit"
      }
    },
    "total_candidates": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    },
    "top_k": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "truncated": {
      "type": "boolean"
    },
    "truncation_reasons": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/truncationReason"
      }
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": ".*\\S.*"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-](?:0[0-9]|1[0-4]):[0-5][0-9])$"
    },
    "finiteNumber": {
      "type": "number"
    },
    "nullableFiniteNumber": {
      "oneOf": [
        {
          "$ref": "#/$defs/finiteNumber"
        },
        {
          "type": "null"
        }
      ]
    },
    "indexVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "index_kind",
        "index_id",
        "index_version",
        "content_sha256"
      ],
      "properties": {
        "index_kind": {
          "enum": [
            "metadata",
            "lexical",
            "semantic",
            "evidence_graph",
            "git_graph"
          ]
        },
        "index_id": {
          "$ref": "#/$defs/identifier"
        },
        "index_version": {
          "$ref": "#/$defs/identifier"
        },
        "content_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "retrievalHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "memory_id",
        "memory_revision_id",
        "candidate_sha256",
        "rank",
        "metadata_score",
        "lexical_score",
        "semantic_score",
        "evidence_graph_score",
        "fused_score",
        "selected_stages"
      ],
      "properties": {
        "memory_id": {
          "$ref": "#/$defs/identifier"
        },
        "memory_revision_id": {
          "type": "string",
          "pattern": "^memory_revision_sha256_[0-9a-f]{64}$"
        },
        "candidate_sha256": {
          "$ref": "#/$defs/digest"
        },
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "metadata_score": {
          "$ref": "#/$defs/nullableFiniteNumber"
        },
        "lexical_score": {
          "$ref": "#/$defs/nullableFiniteNumber"
        },
        "semantic_score": {
          "$ref": "#/$defs/nullableFiniteNumber"
        },
        "evidence_graph_score": {
          "$ref": "#/$defs/nullableFiniteNumber"
        },
        "fused_score": {
          "$ref": "#/$defs/finiteNumber"
        },
        "selected_stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "enum": [
              "metadata",
              "lexical",
              "semantic",
              "evidence_graph",
              "fusion"
            ]
          }
        }
      }
    },
    "truncationReason": {
      "enum": [
        "top_k",
        "minimum_score",
        "authorization",
        "lifecycle",
        "classification",
        "applicability",
        "eval_leakage",
        "git_ancestry",
        "payload_budget"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "truncated": {
            "const": false
          }
        },
        "required": [
          "truncated"
        ]
      },
      "then": {
        "properties": {
          "truncation_reasons": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "truncation_reasons": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
